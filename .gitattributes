# Binary assets are stored as ordinary git blobs, NOT Git LFS.
#
# This repo is deployed by serving the checked-in tree verbatim
# (vercel.json: buildCommand null, outputDirectory "."). Nothing runs
# `git lfs pull` on deploy, so an LFS-tracked file ships as its ~130-byte
# pointer stub instead of the real bytes — the logo, club badges, favicon
# and OG image all rendered broken in production that way.
#
# Keep `-text` so git never applies EOL conversion to these, but do not add
# `filter=lfs` back unless the deployment starts checking LFS objects out.

*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.mp4 -text
*.mov -text
*.mp3 -text
*.wav -text
*.woff -text
*.woff2 -text
*.ttf -text
*.otf -text
*.pdf -text
*.zip -text
