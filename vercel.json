{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/DraftXI/:path*", "destination": "/perfect-cup/:path*", "permanent": true },
    { "source": "/football-manager/:path*", "destination": "/gaffa/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/gaffa/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/gaffa/data/gamedata.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/gaffa/badges/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    }
  ]
}
