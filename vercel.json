{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/DraftXI/:path*", "destination": "/perfect-cup/:path*", "permanent": true },
    { "source": "/football-manager/:path*", "destination": "/gaffa/:path*", "permanent": true }
  ],
  "headers": [
    {
      "comment": "Next hashes these filenames, so a changed build gets a new URL and these can never go stale.",
      "source": "/gaffa/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "comment": "The 1MB player database. Filename is not content-hashed, so it cannot be immutable — an hour of freshness plus a day of stale-while-revalidate keeps repeat visits off the network without pinning a stale squad list.",
      "source": "/gaffa/data/gamedata.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/gaffa/badges/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    }
  ]
}
