# Supabase Configuration
# Get these from https://app.supabase.com/project/[PROJECT_ID]/settings/api

# Public API Key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service Role Key (keep secret, use only on server)
SUPABASE_SERVICE_KEY=eyJhbGci...

# Reddit Bot Configuration
# Create an app at https://www.reddit.com/prefs/apps

REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_bot_account
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=BallKnW Scout Puzzle Bot v1.0

# Discord Bot Configuration
# Create an app at https://discord.com/developers/applications

DISCORD_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_server_id
DISCORD_CHANNEL_ID=your_channel_id

# Feature Flags
ENABLE_EMAIL_CAPTURE=true
ENABLE_ANALYTICS=true
ENABLE_REDDIT_BOT=false
ENABLE_DISCORD_BOT=false
