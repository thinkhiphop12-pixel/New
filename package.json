{
  "name": "ballknw-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/games/football-manager"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build && npm run postbuild",
    "postbuild": "node scripts/postbuild.js",
    "start": "next start",
    "dev:game": "npm -w src/games/football-manager run dev",
    "build:game": "npm -w src/games/football-manager run build",
    "build:all": "npm run build && npm run build:game"
  },
  "dependencies": {
    "@blinkdotnew/sdk": "^2.6.2",
    "@blinkdotnew/ui": "^0.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "autoprefixer": "10.4.16",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "postcss": "8.4.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "react-responsive": "^10.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
